# Copy to .env and fill in. NEVER commit a filled .env to git.
# Every secret comes from here (or from the encrypted vault via the Settings page).
# Nothing is hardcoded anywhere in the code.

# --- Credential vault -------------------------------------------------------
# Fernet key for encrypting stored credentials (API keys, OAuth tokens, WP passwords).
# Generate one with:  python -m app.vault genkey
GEO_VAULT_KEY=

# --- Web sessions ------------------------------------------------------------
# Random string used to sign login cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GEO_SESSION_SECRET=

# --- Database -----------------------------------------------------------------
# Defaults to <project>/data/portal.db (SQLite). Set DATABASE_URL to use
# Postgres instead (Neon free tier) — no code changes needed.
GEO_DB_PATH=
DATABASE_URL=

# --- Public URL ------------------------------------------------------------------
# https URL of the deployed app, e.g. https://geo-portal-xxxx.onrender.com
# Used for the OAuth redirect URI and the self-monitor business. Empty locally.
PUBLIC_URL=

# --- Google OAuth (Search Console + Business Profile) --------------------------
# Created in Google Cloud Console (see README "Setup task 1"). Leave empty
# until you have created the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered in the Cloud Console:
GOOGLE_REDIRECT_URI=http://localhost:8000/connect/google/callback

# --- Email reports (SMTP) ------------------------------------------------------
# Defaults work for Gmail. For Gmail, SMTP_PASS must be an *App Password*,
# not your normal Google password (Google Account > Security > 2-Step Verification
# > App passwords). Leave empty to disable email sending (reports still generate).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Demo mode -------------------------------------------------------------------
# DEMO_MODE=1 seeds a sample business with canned data so the whole UI is
# clickable with zero credentials. NEVER enable in production: real code paths
# never fall back to canned data outside demo mode.
DEMO_MODE=0
